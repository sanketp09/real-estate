const fmt = (n: number) => {
  if (n >= 10000000) return `₹${(n/10000000).toFixed(2)} Cr`
  if (n >= 100000)   return `₹${(n/100000).toFixed(2)} L`
  return `₹${Math.round(n).toLocaleString('en-IN')}`
}

export default function CalculatorPage() {
  const [loan, setLoan]     = useState(5000000)
  const [rate, setRate]     = useState(8.5)
  const [tenure, setTenure] = useState(20)
  const [all, setAll]       = useState(false)

  const { emi, interest, total, amort } = useMemo(() => {
    const r = rate / 12 / 100
    const n = tenure * 12
    const emi = r === 0 ? loan/n : (loan*r*Math.pow(1+r,n))/(Math.pow(1+r,n)-1)
    const total = emi * n
    const interest = total - loan
    const amort: { year:number; principal:number; interest:number; balance:number }[] = []
    let bal = loan
    for (let y = 1; y <= tenure; y++) {
      let yp=0, yi=0
      for (let m=0; m<12; m++) {
        const mi = bal*r; const mp = Math.min(emi-mi, bal)
        yi+=mi; yp+=mp; bal-=mp
        if (bal<=0){ bal=0; break }
      }
      amort.push({ year:y, principal:yp, interest:yi, balance:Math.max(bal,0) })
      if (bal<=0) break
    }
    return { emi, interest, total, amort }
  }, [loan, rate, tenure])

