      </div>

      {/* Main layout */}
      <div className="max-w-7xl mx-auto px-6 pb-24 flex flex-col lg:flex-row gap-8">
        <FilterSidebar filters={filters} setFilters={setFilters} onReset={() => setFilters(defaultFilters)} />

        <div className="flex-1">
          {/* Toolbar */}
          <div className="flex items-center justify-between mb-6 pb-4 border-b border-[#C9A96E]/10">
            <p className="font-dm text-[#6B6460] text-sm">
              <span className="text-[#F5F0E8] font-medium">{filtered.length}</span> properties found
            </p>
            <div className="flex items-center gap-4">
              {/* Sort */}
              <div className="relative">
                <select
                  value={sort}
                  onChange={(e) => setSort(e.target.value)}
                  className="bg-[#111] border border-[#C9A96E]/20 text-[#6B6460] font-dm text-xs px-4 py-2 appearance-none pr-8 focus:outline-none focus:border-[#C9A96E]"
                >
                  <option value="default">Sort By</option>
                  <option value="price-asc">Price ↑</option>
                  <option value="price-desc">Price ↓</option>
                  <option value="newest">Newest</option>
                </select>
                <ChevronDown className="absolute right-2 top-1/2 -translate-y-1/2 w-3 h-3 text-[#6B6460] pointer-events-none" />
              </div>

              {/* View toggle */}
              <div className="flex border border-[#C9A96E]/20">
                <button
                  onClick={() => setView('grid')}
                  className={`p-2 transition-colors ${view === 'grid' ? 'bg-[#C9A96E] text-[#0D0D0D]' : 'text-[#6B6460]'}`}
                >
                  <LayoutGrid className="w-4 h-4" />
                </button>
                <button
                  onClick={() => setView('list')}
                  className={`p-2 transition-colors ${view === 'list' ? 'bg-[#C9A96E] text-[#0D0D0D]' : 'text-[#6B6460]'}`}
                >
                  <List className="w-4 h-4" />
                </button>
              </div>
            </div>
          </div>

          {/* Grid / List */}
          <AnimatePresence mode="wait">
            {view === 'grid' ? (
              <motion.div
                key="grid"
                initial={{ opacity: 0 }}
                animate={{ opacity: 1 }}
                exit={{ opacity: 0 }}
                className="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6"
              >
                {filtered.map((p, i) => (
                  <PropertyCard key={p.id} prop={p} index={i} view="grid" />
                ))}
              </motion.div>
            ) : (
              <motion.div
                key="list"
                initial={{ opacity: 0 }}
                animate={{ opacity: 1 }}
                exit={{ opacity: 0 }}
                className="space-y-4"
              >
                {filtered.map((p, i) => (
                  <PropertyCard key={p.id} prop={p} index={i} view="list" />
                ))}
              </motion.div>
            )}
          </AnimatePresence>

          {filtered.length === 0 && (
            <div className="text-center py-20">
              <p className="font-cormorant text-[#6B6460] text-3xl mb-3">No properties found</p>
              <p className="font-dm text-[#6B6460] text-sm">Try adjusting your filters</p>
            </div>
          )}
        </div>
      </div>
    </div>
  )
}

