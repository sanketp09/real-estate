gsap.registerPlugin(ScrollTrigger)

// ─── Scroll Sequence ────────────────────────────────────────────────────────
function ScrollSequence() {
  const canvasRef = useRef<HTMLCanvasElement>(null)
  const wrapperRef = useRef<HTMLDivElement>(null)
  const framesRef = useRef<HTMLImageElement[]>([])
  const [loading, setLoading] = useState(true)
  const [progress, setProgress] = useState(0)
  const [showText, setShowText] = useState(false)
  const currentFrameRef = useRef(0)

  useEffect(() => {
    const canvas = canvasRef.current
    if (!canvas) return
    const ctx = canvas.getContext('2d')
    if (!ctx) return

    const resize = () => {
      canvas.width = window.innerWidth
      canvas.height = window.innerHeight
    }
    resize()
    window.addEventListener('resize', resize)

    // Preload all 471 frames
    const totalFrames = 471
    const frames: HTMLImageElement[] = []
    let loaded = 0

    const drawFrame = (index: number) => {
      const img = framesRef.current[index]
      if (!img || !img.complete) {
        // Placeholder gradient animation
        const t = index / 471
        const r1 = Math.floor(13 + t * 30), g1 = Math.floor(21 + t * 15), b1 = Math.floor(53 + t * 20)
        const r2 = Math.floor(44 + t * 40), g2 = Math.floor(26 + t * 20), b2 = Math.floor(14 + t * 10)
        const grad = ctx.createLinearGradient(0, 0, canvas.width, canvas.height)
        grad.addColorStop(0, `rgb(${r1},${g1},${b1})`)
        grad.addColorStop(1, `rgb(${r2},${g2},${b2})`)
        ctx.fillStyle = grad
        ctx.fillRect(0, 0, canvas.width, canvas.height)
        return
      }
      const scale = Math.max(canvas.width / img.naturalWidth, canvas.height / img.naturalHeight)
      const x = (canvas.width - img.naturalWidth * scale) / 2
      const y = (canvas.height - img.naturalHeight * scale) / 2
      ctx.clearRect(0, 0, canvas.width, canvas.height)
      ctx.drawImage(img, x, y, img.naturalWidth * scale, img.naturalHeight * scale)
    }

    for (let i = 1; i <= totalFrames; i++) {
      const img = new window.Image()
      img.src = `/frames/frame-${String(i).padStart(3, '0')}.jpg`
      img.onload = () => {
        loaded++
        setProgress(Math.round((loaded / totalFrames) * 100))
        if (loaded === totalFrames) setLoading(false)
      }
      img.onerror = () => {
        loaded++
        setProgress(Math.round((loaded / totalFrames) * 100))
        if (loaded === totalFrames) setLoading(false)
      }
      frames.push(img)
    }
    framesRef.current = frames

    // Simulate load completion for placeholder mode
    const timeout = setTimeout(() => setLoading(false), 2000)

    const ctx2 = gsap.context(() => {
      ScrollTrigger.create({
        trigger: wrapperRef.current,
        start: 'top top',
        end: 'bottom bottom',
        scrub: 0.5,
        onUpdate: (self) => {
          const frameIndex = Math.min(Math.floor(self.progress * (totalFrames - 1)), totalFrames - 1)
          if (frameIndex !== currentFrameRef.current) {
            currentFrameRef.current = frameIndex
            drawFrame(frameIndex)
          }
          setShowText(self.progress > 0.88)
        }
      })
    })

    // Draw first frame
    drawFrame(0)

    return () => {
      window.removeEventListener('resize', resize)
      clearTimeout(timeout)
      ctx2.revert()
    }
  }, [])

  return (
    <>
      {/* Loading Screen */}
      <AnimatePresence>
        {loading && (
          <motion.div
            initial={{ opacity: 1 }}
            exit={{ opacity: 0 }}
            transition={{ duration: 0.8 }}
            className="fixed inset-0 z-[100] bg-[#0D0D0D] flex flex-col items-center justify-center"
          >
            <motion.p
              initial={{ opacity: 0, y: 20 }}
              animate={{ opacity: 1, y: 0 }}
              className="font-cormorant text-[#C9A96E] text-2xl tracking-[0.4em] uppercase mb-12"
            >
              Patil's Real Estate
            </motion.p>
            <div className="w-64 h-px bg-white/10 relative overflow-hidden">
              <motion.div
                className="absolute inset-y-0 left-0 bg-[#C9A96E]"
                style={{ width: `${progress}%` }}
                transition={{ duration: 0.1 }}
              />
            </div>
            <p className="font-dm text-[#6B6460] text-sm mt-4">{progress}%</p>
          </motion.div>
        )}
      </AnimatePresence>

      {/* Scroll wrapper */}
      <div ref={wrapperRef} style={{ height: '600vh' }} className="relative">
        <div className="sticky top-0 h-screen w-full overflow-hidden">
          <canvas ref={canvasRef} className="absolute inset-0 w-full h-full" />

          {/* Text Overlay */}
          <AnimatePresence>
            {showText && (
              <motion.div
                initial={{ opacity: 0 }}
                animate={{ opacity: 1 }}
                className="absolute inset-0 flex flex-col items-center justify-center"
                style={{ background: 'rgba(0,0,0,0.45)' }}
              >
                <motion.p
                  initial={{ opacity: 0, y: 30 }}
                  animate={{ opacity: 1, y: 0 }}
                  transition={{ delay: 0.1 }}
                  className="font-dm text-[#C9A96E] text-sm tracking-[0.35em] uppercase mb-4"
                >
                  Welcome To
                </motion.p>
                <div className="overflow-hidden mb-4">
                  <motion.h1
                    initial={{ y: '100%' }}
                    animate={{ y: 0 }}
                    transition={{ delay: 0.25, duration: 0.8, ease: [0.16, 1, 0.3, 1] }}
                    className="font-cormorant text-[#F5F0E8] text-[7vw] leading-none text-center"
                  >
                    Patil's Real Estate
                  </motion.h1>
                </div>
                <motion.p
                  initial={{ opacity: 0, y: 20 }}
                  animate={{ opacity: 1, y: 0 }}
                  transition={{ delay: 0.5 }}
                  className="font-dm text-[#F5F0E8]/70 text-lg mb-10 text-center"
                >
                  Mumbai's Most Trusted Luxury Properties
                </motion.p>
                <motion.div
                  initial={{ opacity: 0, y: 20 }}
                  animate={{ opacity: 1, y: 0 }}
                  transition={{ delay: 0.7 }}
                >
                  <Link
                    href="/properties"
                    className="group inline-flex items-center gap-3 border border-[#C9A96E] text-[#C9A96E] px-8 py-3 font-dm text-sm tracking-widest uppercase hover:bg-[#C9A96E] hover:text-[#0D0D0D] transition-all duration-300"
                  >
                    Explore Properties
                    <ArrowRight className="w-4 h-4 group-hover:translate-x-1 transition-transform" />
                  </Link>
                </motion.div>
              </motion.div>
            )}
          </AnimatePresence>

          {/* Scroll indicator */}
          <motion.div
            initial={{ opacity: 0 }}
            animate={{ opacity: 1 }}
            transition={{ delay: 1.5 }}
            className="absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2"
          >
            <span className="font-dm text-white/40 text-xs tracking-widest uppercase">Scroll</span>
            <motion.div animate={{ y: [0, 8, 0] }} transition={{ repeat: Infinity, duration: 1.5 }}>
              <ChevronDown className="w-4 h-4 text-[#C9A96E]" />
            </motion.div>
          </motion.div>
        </div>
      </div>
    </>
  )
}

