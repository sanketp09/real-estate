:root {
  --charcoal: #0D0D0D;
  --ivory: #F5F0E8;
  --gold: #C9A96E;
  --gold-light: #E8D5A3;
  --gold-dark: #8A6D3B;
  --warm-white: #FAF8F4;
  --muted: #6B6460;
  --border: rgba(201, 169, 110, 0.2);
  --glass: rgba(13, 13, 13, 0.6);
}

* { box-sizing: border-box; }
html { scroll-behavior: auto; }

body {
  background-color: var(--charcoal);
  color: var(--ivory);
  font-family: 'DM Sans', sans-serif;
  cursor: none;
  overflow-x: hidden;
  -webkit-font-smoothing: antialiased;
}
body * { cursor: none !important; }

.font-display { font-family: 'Cormorant Garamond', serif; }

@keyframes marquee {
  from { transform: translateX(0); }
  to   { transform: translateX(-50%); }
}
.marquee-track {
  display: flex;
  width: max-content;
  animation: marquee 30s linear infinite;
}

@keyframes shimmer {
  0%   { background-position: -200% center; }
  100% { background-position: 200% center; }
}
.gold-progress-bar {
  background: linear-gradient(90deg, var(--gold-dark), var(--gold), var(--gold-light), var(--gold), var(--gold-dark));
  background-size: 200% auto;
  animation: shimmer 2s linear infinite;
}

input[type='range'] {
  -webkit-appearance: none;
  appearance: none;
  width: 100%;
  height: 2px;
  background: var(--border);
  outline: none;
  border-radius: 1px;
}
input[type='range']::-webkit-slider-thumb {
  -webkit-appearance: none;
  appearance: none;
  width: 18px;
  height: 18px;
  border-radius: 50%;
  background: var(--gold);
  cursor: none;
  border: 2px solid var(--charcoal);
  box-shadow: 0 0 0 2px var(--gold);
}

.float-label-wrap { position: relative; }
.float-label-wrap input,
.float-label-wrap textarea,
.float-label-wrap select {
  width: 100%;
  background: transparent;
  border: none;
  border-bottom: 1px solid var(--border);
  color: var(--ivory);
  font-family: 'DM Sans', sans-serif;
  font-size: 0.95rem;
  padding: 1.25rem 0 0.5rem;
  outline: none;
  transition: border-color 0.3s;
}
.float-label-wrap input:focus,
.float-label-wrap textarea:focus { border-bottom-color: var(--gold); }
.float-label-wrap label {
  position: absolute;
  top: 1.25rem;
  left: 0;
  font-size: 0.85rem;
  color: var(--muted);
  transition: all 0.25s ease;
  pointer-events: none;
}
.float-label-wrap input:focus ~ label,
.float-label-wrap input:not(:placeholder-shown) ~ label,
.float-label-wrap textarea:focus ~ label,
.float-label-wrap textarea:not(:placeholder-shown) ~ label {
  top: 0;
  font-size: 0.72rem;
  color: var(--gold);
  letter-spacing: 0.08em;
}

.diagonal-texture {
  background-image: repeating-linear-gradient(
    -45deg, transparent, transparent 4px,
    rgba(201,169,110,0.03) 4px, rgba(201,169,110,0.03) 5px
  );
}

@keyframes gradientShift {
  0%   { background-position: 0% 50%; }
  50%  { background-position: 100% 50%; }
