  filters: Filters
  setFilters: (f: Filters) => void
  onReset: () => void
}) {
  const toggle = (key: 'types' | 'locations' | 'statuses', val: string) => {
    const arr = filters[key] as string[]
    setFilters({
      ...filters,
      [key]: arr.includes(val) ? arr.filter((x) => x !== val) : [...arr, val],
    })
  }
  const toggleBhk = (val: number) => {
    setFilters({
      ...filters,
      bhk: filters.bhk.includes(val) ? filters.bhk.filter((x) => x !== val) : [...filters.bhk, val],
    })
  }

  const formatBudget = (val: number) => {
    if (val >= 100) return `₹${val / 100} Cr`
    return `₹${val} L`
