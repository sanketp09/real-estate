      <div className={`p-5 bg-[#0D0D0D] border-b border-x transition-colors duration-300 ${hovered ? 'border-[#C9A96E]/60' : 'border-[#C9A96E]/10'}`}>
        <h3 className="font-cormorant text-[#F5F0E8] text-xl mb-1">{prop.name}</h3>
